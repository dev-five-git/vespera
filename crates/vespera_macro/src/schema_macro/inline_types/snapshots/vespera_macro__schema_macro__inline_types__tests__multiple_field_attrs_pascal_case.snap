#[derive(Clone, serde::Serialize, serde::Deserialize, vespera::Schema)]
#[serde(rename_all = "PascalCase")]
pub struct MultiAttrType {
    #[serde(default)]
    #[serde(skip_serializing_if = "Option::is_none")]
    pub field: String,
}
