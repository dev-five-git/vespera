#[derive(Clone, serde::Serialize, serde::Deserialize, vespera::Schema)]
#[serde(rename_all = "camelCase")]
pub struct ComplexType {
    pub id: i32,
    pub tags: Vec<String>,
    pub metadata: Option<std::collections::HashMap<String, serde_json::Value>>,
}
