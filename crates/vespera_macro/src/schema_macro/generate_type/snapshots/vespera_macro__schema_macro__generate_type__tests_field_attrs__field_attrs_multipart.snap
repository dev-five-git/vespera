#[derive(vespera::Multipart, ::garde::Validate, vespera::Schema)]
#[garde(context(Ctx))]
#[serde(rename_all = "camelCase")]
pub struct Dto {
    #[schema(minimum = 1)]
    #[cfg(feature = "x")]
    #[garde(skip)]
    pub gated: i32,
    #[garde(length(min = 1))]
    #[deprecated]
    pub title: String,
    #[garde(skip)]
    pub seeded: i32,
    #[schema(default = 9)]
    #[garde(skip)]
    pub overridden: i32,
    #[cfg_attr(feature = "x", schema(maximum = 3))]
    #[garde(skip)]
    pub plain: bool,
}

