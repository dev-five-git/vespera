#[derive(vespera::Multipart, vespera::Schema)]
pub struct UpDto {
    #[form_data(default)]
    pub files: Vec<vespera::multipart::FieldData<vespera::tempfile::NamedTempFile>>,
    #[form_data(default)]
    pub tags: std::vec::Vec<String>,
    #[serde(default)]
    pub own: Vec<u8>,
    #[form_data(default)]
    pub kept: Vec<u8>,
    pub opt: Option<Vec<u8>>,
    pub title: String,
}
