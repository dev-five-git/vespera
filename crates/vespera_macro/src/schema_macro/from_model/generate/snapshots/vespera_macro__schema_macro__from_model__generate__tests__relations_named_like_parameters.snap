#[allow(deprecated)]
impl ListingSchema {
    pub async fn from_model(
        __vespera_model: Model,
        __vespera_db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let model = {
            let fk_value = &__vespera_model.model_id;
            <bakery::Entity as sea_orm::EntityTrait>::find_by_id(fk_value.clone())
                .one(__vespera_db)
                .await?
        };
        let db = match &__vespera_model.db_id {
            Some(fk_value) => {
                <bakery::Entity as sea_orm::EntityTrait>::find_by_id(fk_value.clone())
                    .one(__vespera_db)
                    .await?
            }
            None => None,
        };
        Ok(Self {
            id: __vespera_model.id,
            model: model
                .ok_or_else(|| sea_orm::DbErr::RecordNotFound(
                    format!("Required relation '{}' not found", stringify!(model)),
                ))
                .map(|r| Box::new(<bakery::Schema as From<_>>::from(r)))?,
            db: db.map(|r| Box::new(<bakery::Schema as From<_>>::from(r))),
        })
    }
}
