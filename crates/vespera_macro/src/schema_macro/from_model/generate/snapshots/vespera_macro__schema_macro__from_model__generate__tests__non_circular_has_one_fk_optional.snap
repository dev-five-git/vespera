#[allow(deprecated)]
impl UserSchema {
    pub async fn from_model(
        __vespera_model: crate::models::user::Model,
        __vespera_db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let address = sea_orm::ModelTrait::find_related(
                &__vespera_model,
                crate::models::address::Entity,
            )
            .one(__vespera_db)
            .await?;
        Ok(Self {
            id: __vespera_model.id,
            address: match address {
                Some(r) => {
                    Some(
                        Box::new(
                            crate::models::address::Schema::from_model(r, __vespera_db)
                                .await?,
                        ),
                    )
                }
                None => None,
            },
        })
    }
}
