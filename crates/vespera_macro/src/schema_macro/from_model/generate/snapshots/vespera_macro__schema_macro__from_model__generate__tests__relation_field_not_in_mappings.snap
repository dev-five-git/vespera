#[allow(deprecated)]
impl TestSchema {
    pub async fn from_model(
        __vespera_model: Model,
        __vespera_db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let user = sea_orm::ModelTrait::find_related(&__vespera_model, user::Entity)
            .one(__vespera_db)
            .await?;
        Ok(Self {
            id: __vespera_model.id,
            owner: Default::default(),
        })
    }
}
