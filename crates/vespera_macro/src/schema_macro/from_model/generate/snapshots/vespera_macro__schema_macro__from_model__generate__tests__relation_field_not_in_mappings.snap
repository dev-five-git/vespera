impl TestSchema {
    pub async fn from_model(
        model: Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let user = sea_orm::ModelTrait::find_related(&model, user::Entity)
            .one(db)
            .await?;
        Ok(Self {
            id: model.id,
            owner: Default::default(),
        })
    }
}
