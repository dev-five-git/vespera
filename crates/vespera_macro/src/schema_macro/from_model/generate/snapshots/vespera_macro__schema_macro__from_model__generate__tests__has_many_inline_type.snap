#[allow(deprecated)]
impl UserSchema {
    pub async fn from_model(
        model: Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let memos = sea_orm::ModelTrait::find_related(&model, memo::Entity)
            .all(db)
            .await?;
        Ok(Self {
            id: model.id,
            memos: memos.into_iter().map(|r| Default::default()).collect(),
        })
    }
}
