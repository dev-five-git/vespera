#[allow(deprecated)]
impl AccountSchema {
    pub async fn from_model(
        __vespera_model: crate::models::account::Model,
        __vespera_db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let owner = {
            let fk_value = &__vespera_model.owner_id;
            <crate::models::owner::Entity as sea_orm::EntityTrait>::find_by_id(
                    fk_value.clone(),
                )
                .one(__vespera_db)
                .await?
        };
        Ok(Self {
            id: __vespera_model.id,
            owner: owner
                .ok_or_else(|| sea_orm::DbErr::RecordNotFound(
                    format!("Required relation '{}' not found", stringify!(owner)),
                ))
                .map(|r| Box::new(<crate::models::owner::Schema as From<_>>::from(r)))?,
        })
    }
}
