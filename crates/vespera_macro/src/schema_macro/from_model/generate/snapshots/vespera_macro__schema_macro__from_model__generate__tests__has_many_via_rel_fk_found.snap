#[allow(deprecated)]
impl UserSchema {
    pub async fn from_model(
        model: crate::models::user::Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let target_user_notifications = sea_orm::QueryFilter::filter(
                <crate::models::notification::Entity as sea_orm::EntityTrait>::find(),
                sea_orm::ColumnTrait::eq(
                    &crate::models::notification::Column::TargetUserId,
                    model.id.clone(),
                ),
            )
            .all(db)
            .await?;
        let __parent_stub__ = Self {
            id: model.id.clone(),
            target_user_notifications: vec![],
        };
        Ok(Self {
            id: model.id,
            target_user_notifications: target_user_notifications
                .into_iter()
                .map(|r| crate::models::notification::Schema {
                    id: r.id,
                    message: r.message,
                    target_user_id: r.target_user_id,
                    target_user: Box::new(__parent_stub__.clone()),
                })
                .collect(),
        })
    }
}
