impl UserSchema {
    pub async fn from_model(
        model: crate::models::user::Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        use sea_orm::ModelTrait;
        let memos = model.find_related(crate::models::memo::Entity).all(db).await?;
        Ok(Self {
            id: model.id,
            memos: memos
                .into_iter()
                .map(|r| crate::models::memo::Schema {
                    id: r.id,
                    title: r.title,
                    user: None,
                })
                .collect(),
        })
    }
}
