#[allow(deprecated)]
impl UserSchema {
    pub async fn from_model(
        model: crate::models::user::Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let profile = sea_orm::ModelTrait::find_related(
                &model,
                crate::models::profile::Entity,
            )
            .one(db)
            .await?;
        Ok(Self {
            id: model.id,
            profile: profile
                .map(|r| Box::new(crate::models::profile::Schema {
                    id: r.id,
                    bio: r.bio,
                    user: None,
                })),
        })
    }
}
