#[allow(deprecated)]
impl MemoSchema {
    pub async fn from_model(
        model: Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let target_user = match &model.target_user_id {
            Some(fk_value) => {
                <user::Entity as sea_orm::EntityTrait>::find_by_id(fk_value.clone())
                    .one(db)
                    .await?
            }
            None => None,
        };
        Ok(Self {
            id: model.id,
            target_user: target_user
                .map(|r| Box::new(<user::Schema as From<_>>::from(r))),
        })
    }
}
