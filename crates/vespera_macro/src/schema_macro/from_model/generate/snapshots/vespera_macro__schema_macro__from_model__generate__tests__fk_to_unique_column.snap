#[allow(deprecated)]
impl AccountSchema {
    pub async fn from_model(
        __vespera_model: crate::models::account::Model,
        __vespera_db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let owner = match &__vespera_model.owner_code {
            Some(fk_value) => {
                sea_orm::QueryFilter::filter(
                        <crate::models::owner::Entity as sea_orm::EntityTrait>::find(),
                        sea_orm::ColumnTrait::eq(
                            &crate::models::owner::Column::Code,
                            fk_value.clone(),
                        ),
                    )
                    .one(__vespera_db)
                    .await?
            }
            None => None,
        };
        Ok(Self {
            id: __vespera_model.id,
            owner: owner
                .map(|r| Box::new(<crate::models::owner::Schema as From<_>>::from(r))),
        })
    }
}
