#[allow(deprecated)]
impl UserSchema {
    pub async fn from_model(
        __vespera_model: crate::models::user::Model,
        __vespera_db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let profile = sea_orm::QueryFilter::filter(
                <crate::models::profile::Entity as sea_orm::EntityTrait>::find(),
                sea_orm::ColumnTrait::eq(
                    &crate::models::profile::Column::OwnerId,
                    __vespera_model.id.clone(),
                ),
            )
            .one(__vespera_db)
            .await?;
        Ok(Self {
            id: __vespera_model.id,
            profile: match profile {
                Some(r) => {
                    Some(
                        Box::new(
                            crate::models::profile::Schema::from_model(r, __vespera_db)
                                .await?,
                        ),
                    )
                }
                None => None,
            },
        })
    }
}
