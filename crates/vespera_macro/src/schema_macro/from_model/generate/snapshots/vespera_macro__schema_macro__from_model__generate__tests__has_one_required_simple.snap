#[allow(deprecated)]
impl MemoSchema {
    pub async fn from_model(
        model: Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let user = sea_orm::ModelTrait::find_related(&model, user::Entity)
            .one(db)
            .await?;
        Ok(Self {
            id: model.id,
            user: Box::new(
                <user::Schema as From<
                    _,
                >>::from(
                    user
                        .ok_or_else(|| sea_orm::DbErr::RecordNotFound(
                            format!("Required relation '{}' not found", stringify!(user)),
                        ))?,
                ),
            ),
        })
    }
}
