#[allow(deprecated)]
impl MemoSchema {
    pub async fn from_model(
        __vespera_model: Model,
        __vespera_db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let user = sea_orm::ModelTrait::find_related(&__vespera_model, user::Entity)
            .one(__vespera_db)
            .await?;
        Ok(Self {
            id: __vespera_model.id,
            user: user
                .ok_or_else(|| sea_orm::DbErr::RecordNotFound(
                    format!("Required relation '{}' not found", stringify!(user)),
                ))
                .map(|r| Box::new(<user::Schema as From<_>>::from(r)))?,
        })
    }
}
