impl CommentSchema {
    pub async fn from_model(
        model: Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let post = <post::Entity as sea_orm::EntityTrait>::find_by_id(
                model.post_id.clone(),
            )
            .one(db)
            .await?;
        Ok(Self {
            id: model.id,
            post: Box::new(
                <post::Schema as From<
                    _,
                >>::from(
                    post
                        .ok_or_else(|| sea_orm::DbErr::RecordNotFound(
                            format!("Required relation '{}' not found", stringify!(post)),
                        ))?,
                ),
            ),
        })
    }
}
