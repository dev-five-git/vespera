#[allow(deprecated)]
impl CommentSchema {
    pub async fn from_model(
        __vespera_model: Model,
        __vespera_db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        let post = {
            let fk_value = &__vespera_model.post_id;
            <post::Entity as sea_orm::EntityTrait>::find_by_id(fk_value.clone())
                .one(__vespera_db)
                .await?
        };
        Ok(Self {
            id: __vespera_model.id,
            post: post
                .ok_or_else(|| sea_orm::DbErr::RecordNotFound(
                    format!("Required relation '{}' not found", stringify!(post)),
                ))
                .map(|r| Box::new(<post::Schema as From<_>>::from(r)))?,
        })
    }
}
