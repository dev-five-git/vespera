impl MemoSchema {
    pub async fn from_model(
        model: Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        use sea_orm::ModelTrait;
        let author = Entity::find_related(Relation::Author)
            .filter(<Entity as sea_orm::EntityTrait>::PrimaryKey::eq(&model))
            .one(db)
            .await?;
        Ok(Self {
            id: model.id,
            author: author.map(|r| Box::new(<user::Schema as From<_>>::from(r))),
        })
    }
}
