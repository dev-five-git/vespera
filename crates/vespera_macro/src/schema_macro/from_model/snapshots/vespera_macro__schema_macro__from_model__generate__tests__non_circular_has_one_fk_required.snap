impl UserSchema {
    pub async fn from_model(
        model: crate::models::user::Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        use sea_orm::ModelTrait;
        let address = model.find_related(crate::models::address::Entity).one(db).await?;
        Ok(Self {
            id: model.id,
            address: Box::new(
                crate::models::address::Schema::from_model(
                        address
                            .ok_or_else(|| sea_orm::DbErr::RecordNotFound(
                                format!(
                                    "Required relation '{}' not found", stringify!(address)
                                ),
                            ))?,
                        db,
                    )
                    .await?,
            ),
        })
    }
}
