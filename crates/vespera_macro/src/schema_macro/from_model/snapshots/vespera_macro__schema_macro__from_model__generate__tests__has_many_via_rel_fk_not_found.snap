impl UserSchema {
    pub async fn from_model(
        model: crate::models::user::Model,
        db: &sea_orm::DatabaseConnection,
    ) -> Result<Self, sea_orm::DbErr> {
        use sea_orm::ModelTrait;
        let notifications: Vec<_> = vec![];
        Ok(Self {
            id: model.id,
            notifications: notifications
                .into_iter()
                .map(|r| <crate::models::notification::Schema as From<_>>::from(r))
                .collect(),
        })
    }
}
