impl<
    __VesperaS__: Send + Sync,
> vespera::multipart::TryFromMultipartWithState<__VesperaS__> for F {
    async fn try_from_multipart_with_state(
        __multipart__: &mut vespera::axum::extract::Multipart,
        __state__: &__VesperaS__,
    ) -> std::result::Result<Self, vespera::multipart::TypedMultipartError> {
        let mut data: std::option::Option<String> = std::option::Option::None;
        while let std::option::Option::Some(__field__) = __multipart__
            .next_field()
            .await
            .map_err(vespera::multipart::TypedMultipartError::from)?
        {
            vespera::multipart::register_multipart_part()?;
            let __field__ = vespera::multipart::MeteredField::__from_field(__field__);
            let __field_name__ = match __field__.name() {
                std::option::Option::Some("") | std::option::Option::None => continue,
                std::option::Option::Some(__name__) => __name__,
            };
            match __field_name__ {
                "upload" => {
                    data = std::option::Option::Some(
                        <String as vespera::multipart::TryFromFieldWithState<
                            __VesperaS__,
                        >>::try_from_field_with_state(
                                __field__,
                                std::option::Option::Some(1024usize),
                                __state__,
                            )
                            .await?,
                    );
                }
                _ => {}
            }
        }
        let data = data
            .ok_or(vespera::multipart::TypedMultipartError::MissingField {
                field_name: std::string::String::from("upload"),
            })?;
        std::result::Result::Ok(Self { data })
    }
}
