/// A colour.
    #[serde(into = "String")]
    struct Rgb { r: u8, g: u8, b: u8 }

--- response ---
{
  "type": "string",
  "description": "A colour."
}
--- request ---
{
  "type": "object",
  "description": "A colour.",
  "properties": {
    "b": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0,
      "maximum": 255
    },
    "g": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0,
      "maximum": 255
    },
    "r": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0,
      "maximum": 255
    }
  },
  "required": [
    "r",
    "g",
    "b"
  ]
}
