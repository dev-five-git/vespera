---
source: crates/vespera_core/src/docs.rs
expression: swagger_ui_html(HOSTILE_SPEC)
---
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Swagger UI</title><meta name="viewport" content="width=device-width, initial-scale=1"><link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5.34.0/swagger-ui.css" integrity="sha384-4c3vsE5f+trhFyHrFrLM1fFGUn531NIaC7dcqEWIJdoRQJ5CkJbSuSCwXLpaS1KF" crossorigin="anonymous" /></head><body style="margin: 0; padding: 0;"><div id="swagger-ui"></div><script src="https://unpkg.com/swagger-ui-dist@5.34.0/swagger-ui-bundle.js" integrity="sha384-9Td7MKiIr2S83E1kZyyVi8KdJw/S8CpAvu0llLyMeg0xq/hDGiZJfVn0fV4llCmK" crossorigin="anonymous"></script><script src="https://unpkg.com/swagger-ui-dist@5.34.0/swagger-ui-standalone-preset.js" integrity="sha384-My2aDM4r2Mbm3ybHcubKm9O9U8FEjvF/O5nGvE9YK5dzqOTbWEKa79RPJ1krdMaF" crossorigin="anonymous"></script><script>const openapiSpec = {"info":{"description":"\u003c/script\u003e\u003cscript\u003ealert(1)\u003c/script\u003e\u003c!-- a\u0026b \u2028\u2029"}};window.onload = () => { SwaggerUIBundle({ spec: openapiSpec, dom_id: "#swagger-ui", presets: [SwaggerUIBundle.presets.apis, SwaggerUIStandalonePreset], layout: "StandaloneLayout" }); };</script></body></html>
